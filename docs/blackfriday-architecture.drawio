        <!-- ══════════════════════════════════════════════
             EDGES
             Color key:
               Purple  #8C4FFF — network / routing
               Orange  #FF9900 — compute traffic
               Green   #3E8C00 — database
               Red     #DD3522 — security (dashed)
               Olive   #7AA116 — CI/CD
               Pink    #E7157B — monitoring (dashed)
        ══════════════════════════════════════════════ -->

        <!-- 1. Users → CloudFront -->
        <mxCell id="e01" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#232F3E;fontSize=10;fontStyle=1;" edge="1" source="users" target="cf" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. CloudFront → IGW (origin request) -->
        <mxCell id="e02" value="origin request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="cf" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. IGW → WAF -->
        <mxCell id="e03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;" edge="1" source="igw" target="waf" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. WAF → ALB -->
        <mxCell id="e04" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="waf" target="alb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. ALB → ASG (consolidated — fans out to all EC2 targets) -->
        <mxCell id="e05" value="port 8000&#xa;round-robin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#FF9900;strokeWidth=2;fontColor=#232F3E;fontSize=10;fontStyle=1;" edge="1" source="alb" target="asg_box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. ASG → RDS Proxy (consolidated from all 3 EC2s) -->
        <mxCell id="e06" value=":5432 TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3E8C00;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="asg_box" target="rdsproxy" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 7. RDS Proxy → RDS -->
        <mxCell id="e07" value=":5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3E8C00;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="rdsproxy" target="rds" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 8. ASG → Redis -->
        <mxCell id="e08" value=":6379 TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#3E8C00;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="asg_box" target="redis" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 9. ASG → Secrets Manager (dashed) -->
        <mxCell id="e09" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#DD3522;strokeWidth=1;fontColor=#232F3E;fontSize=9;dashed=1;" edge="1" source="asg_box" target="secrets" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 10. RDS Proxy → Secrets Manager (dashed) -->
        <mxCell id="e10" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#DD3522;strokeWidth=1;fontColor=#232F3E;fontSize=9;dashed=1;" edge="1" source="rdsproxy" target="secrets" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 11. ASG → NAT (outbound, dashed) -->
        <mxCell id="e11" value="outbound" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=1;fontColor=#232F3E;fontSize=9;dashed=1;" edge="1" source="asg_box" target="nat" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 12. NAT → IGW (internet egress path) -->
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=1;dashed=1;" edge="1" source="nat" target="igw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 13. GitHub → S3 App Artifacts -->
        <mxCell id="e13" value="upload artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7AA116;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="github" target="s3app" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 14. GitHub → S3 Terraform State -->
        <mxCell id="e14" value="terraform state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7AA116;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="github" target="s3state" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 15. S3 App → ASG (user_data download on boot) -->
        <mxCell id="e15" value="s3:GetObject on boot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7AA116;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="s3app" target="asg_box" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 16. ALB → CloudWatch -->
        <mxCell id="e16" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E7157B;strokeWidth=1;fontColor=#E7157B;fontSize=9;dashed=1;" edge="1" source="alb" target="cw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 17. ASG → CloudWatch -->
        <mxCell id="e17" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E7157B;strokeWidth=1;fontColor=#E7157B;fontSize=9;dashed=1;" edge="1" source="asg_box" target="cw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 18. RDS → CloudWatch -->
        <mxCell id="e18" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E7157B;strokeWidth=1;fontColor=#E7157B;fontSize=9;dashed=1;" edge="1" source="rds" target="cw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 19. Redis → CloudWatch -->
        <mxCell id="e19" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E7157B;strokeWidth=1;fontColor=#E7157B;fontSize=9;dashed=1;" edge="1" source="redis" target="cw" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 20. CloudWatch → SNS alarm -->
        <mxCell id="e20" value="alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#E7157B;strokeWidth=2;fontColor=#E7157B;fontSize=10;fontStyle=1;" edge="1" source="cw" target="sns" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 21. S3 Terraform State ↔ DynamoDB (state locking) -->
        <mxCell id="e21" value="state lock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#7AA116;strokeWidth=2;fontColor=#232F3E;fontSize=10;" edge="1" source="s3state" target="dynamodb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 22. RDS Proxy → NAT Gateway (no VPC endpoint for Secrets Manager, must use NAT) -->
        <mxCell id="e22" value="outbound" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#8C4FFF;strokeWidth=1;fontColor=#232F3E;fontSize=9;dashed=1;" edge="1" source="rdsproxy" target="nat" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

